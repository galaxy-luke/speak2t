{
  "name": "speak2t",
  "version": "0.1.0",
  "description": "Desktop voice-to-text input tool for Traditional Chinese (Taiwan). Local processing, privacy-first.",
  "main": "dist/main/index.js",
  "author": "Luke",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:icons && npm run build:renderer && npm run build:main && npm run build:preload",
    "build:icons": "node scripts/build-icons.mjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win:dir": "npm run build && electron-builder --win --x64 --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:x64": "npm run build && electron-builder --mac --x64",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "build:mac:universal": "npm run build && electron-builder --mac --universal",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "download-model": "node scripts/download-model.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kutalia/whisper-node-addon": "^1.1.0",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sherpa-onnx-node": "^1.13.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.luke.speak2t",
    "productName": "Speak2T",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "assets/icon.ico",
      "assets/tray-icon.png"
    ],
    "extraResources": [
      {
        "from": "assets/icon-square.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Speak2T-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Speak2T"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon-square.png",
      "category": "public.app-category.productivity",
      "artifactName": "Speak2T-${version}-${arch}.${ext>",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Speak2T 需要麥克風權限來接收您的語音並轉成文字"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "galaxy-luke",
      "repo": "speak2t",
      "releaseType": "release"
    }
  }
}
